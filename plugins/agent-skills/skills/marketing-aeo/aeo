#!/usr/bin/env bash
# Runs the aeo CLI with bun (zero install) while keeping the caller's cwd,
# because project data lives in ./.aeo/ of whatever directory you run it from.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v bun >/dev/null 2>&1; then
  echo "error: aeo needs bun (https://bun.sh): curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi
exec bun "$SCRIPT_DIR/src/cli.ts" "$@"
